function doGet() {
  const ss = SpreadsheetApp.openById("15Tuajr2rs6RHCpy7ElyOECmLVSQRPBeDfX8P7mXY86A");
  const sh = ss.getSheets().find(s => s.getSheetId() === 1267186563) || ss.getSheetByName("hasil");
  const v = sh.getDataRange().getDisplayValues();
  const headers = v[0].map(h => String(h).trim());
  const rows = v.slice(1).map(r => {
    const o = {}; headers.forEach((h, i) => o[h] = r[i]); return o;
  });
  return ContentService.createTextOutput(JSON.stringify({ ok: true, headers, rows }))
    .setMimeType(ContentService.MimeType.JSON);
}
